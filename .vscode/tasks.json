{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "mise: dev",
      "type": "process",
      "command": "mise",
      "args": ["run", "dev"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building",
          "endsPattern": "Local:.*http://localhost:4200"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "mise: install",
      "type": "process",
      "command": "mise",
      "args": ["run", "install"],
      "problemMatcher": []
    },
    {
      "label": "mise: build",
      "type": "process",
      "command": "mise",
      "args": ["run", "build"],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "mise: lint",
      "type": "process",
      "command": "mise",
      "args": ["run", "lint"],
      "problemMatcher": []
    },
    {
      "label": "mise: test",
      "type": "process",
      "command": "mise",
      "args": ["run", "test"],
      "problemMatcher": []
    },
    {
      "label": "mise: check",
      "type": "process",
      "command": "mise",
      "args": ["run", "check"],
      "problemMatcher": []
    }
  ]
}
