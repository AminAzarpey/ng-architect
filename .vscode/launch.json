{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Angular dev server",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "mise: dev",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Angular unit tests",
      "type": "node-terminal",
      "request": "launch",
      "command": "mise run test",
      "cwd": "${workspaceFolder}"
    }
  ]
}
