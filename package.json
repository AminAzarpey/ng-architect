{
  "name": "ng-architect",
  "version": "0.2.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/angular.mjs serve",
    "build": "node scripts/angular.mjs build",
    "watch": "node scripts/angular.mjs build --watch --configuration development",
    "test": "ng test",
    "prepare": "husky",
    "commit": "cz",
    "pretty-quick": "pretty-quick --staged",
    "lint": "ng lint",
    "format": "prettier --write .",
    "release": "release-it",
    "lint:fix": "ng lint --fix",
    "test:ci": "ng test --watch=false",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,scss,css,js,cjs,mjs,yml,yaml}": "prettier --write"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "22.2.1",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/material": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "8.5.28",
    "rxjs": "7.8.2",
    "tailwindcss": "4.3.3",
    "tslib": "2.8.1",
    "primeng": "22.1.2",
    "@primeuix/themes": "3.0.1",
    "primeicons": "8.0.2"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@release-it/conventional-changelog": "12.0.2",
    "angular-eslint": "22.5.0",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jsdom": "30.1.1",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "pretty-quick": "4.2.2",
    "release-it": "21.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": false
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "infile": "CHANGELOG.md",
        "preset": {
          "name": "conventionalcommits",
          "type": [
            {
              "type": "feat",
              "section": "Features"
            },
            {
              "type": "fix",
              "section": "Bug Fixes"
            }
          ]
        }
      }
    }
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=12.2.0 <13"
  },
  "packageManager": "npm@12.2.0",
  "overrides": {
    "release-it": {
      "undici": "7.30.0"
    }
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
